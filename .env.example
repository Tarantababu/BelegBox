# --- mustang-svc (L1 XSD + L2 KoSIT/Schematron) -------------------------------
MUSTANG_SVC_URL=http://localhost:8081

# --- Postgres ----------------------------------------------------------------
DATABASE_URL=postgres://belegbox:belegbox@localhost:5432/belegbox

# --- Object storage (MinIO locally, S3 + Object Lock in prod) ----------------
# The bucket MUST be created with object locking enabled - it cannot be turned
# on afterwards:  mc mb --with-lock local/belegbox-raw-dev
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET_RAW=belegbox-raw-dev
S3_ACCESS_KEY_ID=belegbox
S3_SECRET_ACCESS_KEY=belegbox-dev-secret

# GOVERNANCE outside production, COMPLIANCE in it. COMPLIANCE cannot be lifted
# by anyone, including the account root, until the retain-until date passes.
# That is the property GoBD needs and the one that makes a mistake permanent.
S3_OBJECT_LOCK_MODE=GOVERNANCE

# 10 years for invoices (§ 14b UStG), 8 for accounting vouchers (BEG IV).
# Counted from the end of the calendar year, not the day of receipt.
RETENTION_YEARS=10

# --- Inbound mail (ingest worker) --------------------------------------------
# postmark | mailgun. Both are implemented; Postmark is the default.
INGEST_PROVIDER=postmark

# Postmark does not sign inbound webhooks. Authentication is HTTP Basic
# credentials embedded in the webhook URL, so this must be a high-entropy value
# from the secret store - never a memorable password.
POSTMARK_WEBHOOK_USER=hook
POSTMARK_WEBHOOK_PASSWORD=change-me

# Mailgun HTTP webhook signing key - not the sending API key.
MAILGUN_SIGNING_KEY=

# Where raw documents land until week 2 swaps in S3 Object Lock.
INGEST_STORE_DIR=.data/ingest

# --- Authentication -----------------------------------------------------------
# Session cookies are Secure unless this is set. Only local http needs it.
INSECURE_COOKIES=false

# Outbound mail. Without a token the API prints reset mail to the log and says
# so - a silent no-op sender is how a reset flow reaches staging looking like it
# works.
POSTMARK_TOKEN=
MAIL_FROM=no-reply@belegbox.de
WEB_URL=http://localhost:3000

# Development only, and refused in production: returns the reset link in the
# API response so the flow is testable without a mail provider.
REVEAL_RESET_LINK=false
