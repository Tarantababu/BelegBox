{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "API_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "MUSTANG_SVC_URL",
        "S3_TEST_ENDPOINT",
        "S3_TEST_BUCKET",
        "S3_TEST_ACCESS_KEY",
        "S3_TEST_SECRET_KEY"
      ]
    },
    "lint": {}
  }
}
