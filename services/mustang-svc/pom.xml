<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.belegbox</groupId>
  <artifactId>mustang-svc</artifactId>
  <version>0.0.0-sprint0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kosit.validationtool.version>1.5.0</kosit.validationtool.version>
    <saxon.version>10.9</saxon.version>
    <jaxb.version>2.3.9</jaxb.version>
    <slf4j.version>2.0.16</slf4j.version>
    <commons.lang3.version>3.17.0</commons.lang3.version>
    <commons.io.version>2.18.0</commons.io.version>
    <commons.collections4.version>4.4</commons.collections4.version>
  </properties>

  <!--
    The HTTP layer stays the JDK's own com.sun.net.httpserver - no framework,
    because the service does two things.

    de.kosit:validationtool is the official validator the public procurement
    portals run. Using the same engine means a document that passes here passes
    there, and it makes "the official validator" an accurate statement rather
    than a marketing one.
  -->
  <dependencies>
    <dependency>
      <groupId>de.kosit</groupId>
      <artifactId>validationtool</artifactId>
      <version>${kosit.validationtool.version}</version>
    </dependency>

    <!--
      The published validationtool pom declares no dependencies at all, but the
      jar compiles against Saxon and unmarshals SVRL with JAXB. Both are
      therefore declared here explicitly and pinned: an unpinned XSLT processor
      is an unpinned Schematron result, which R-2 does not allow.
    -->
    <dependency>
      <groupId>net.sf.saxon</groupId>
      <artifactId>Saxon-HE</artifactId>
      <version>${saxon.version}</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>${jaxb.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${commons.lang3.version}</version>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>${commons.io.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-collections4</artifactId>
      <version>${commons.collections4.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <!-- A binding is required or the validator dies on first log call. Warnings
         and above only: the engine is chatty at info about every scenario. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>mustang-svc</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>versions.properties</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- One self-contained jar: the runtime image has a JRE and this file. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>de.belegbox.mustang.App</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>de.belegbox.mustang.App</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
