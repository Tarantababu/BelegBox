{
  "name": "belegbox",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "validate": "tsx apps/cli/src/index.ts validate",
    "corpus:snapshot": "pnpm --filter @belegbox/cli test",
    "corpus:fetch": "bash scripts/fetch-zugferd-corpus.sh",
    "svc:up": "docker compose up -d",
    "svc:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
